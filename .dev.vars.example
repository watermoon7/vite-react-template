# Copy to .dev.vars for local development (never commit .dev.vars).
# In production set these with: npx wrangler secret put <NAME>
SESSION_SECRET=replace-with-a-long-random-string
PASSWORD_WILL=replace-me
PASSWORD_THEO=replace-me

# Optional: Cloudflare Realtime TURN key, used as a relay when the voice room cannot
# open a direct connection. Without these the room falls back to STUN only.
# TURN_KEY_ID=
# TURN_API_TOKEN=
